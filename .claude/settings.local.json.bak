{
  "permissions": {
    "allow": [
      "Bash(cargo init:*)",
      "Bash(cargo check:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(cargo test:*)",
      "Bash(cargo build:*)",
      "Bash(cargo run:*)",
      "Bash(git checkout:*)",
      "Bash(git:*)",
      "Bash(cargo doc:*)",
      "Bash(grep -r \"pub fn size\\\\|pub fn area\\\\|pub fn viewport\" ~/.cargo/registry/src/*/ratatui-0.26*/src/frame.rs)",
      "Bash(grep -r \"impl.*Frame\" ~/.cargo/registry/src/*/ratatui-0.26*/src/frame.rs)",
      "Bash(script -q /dev/null sh -c 'RUST_LOG=debug cargo run')",
      "Bash(pkill -f \"cc-switch-tui\")",
      "Bash(grep:*)",
      "Bash(cargo clippy:*)",
      "Bash(npx ctx7@latest:*)",
      "mcp__chrome-devtools__new_page",
      "mcp__chrome-devtools__list_pages",
      "WebSearch",
      "Bash(cargo search:*)",
      "Bash(gh search:*)",
      "Bash(cargo info:*)",
      "WebFetch(domain:docs.rs)",
      "Bash(curl -s \"https://api.github.com/repos/ricardodantas/ratatui-themes\")",
      "Bash(curl -s \"https://api.github.com/repos/diegorodrigo90/ratatui-themekit\")",
      "Bash(curl -s \"https://api.github.com/repos/preiter93/tui-theme-builder\")",
      "Bash(find ~/.cargo/registry/src/index.crates.io-*/ratatui-themes-0.2.0 -name \"*.rs\" -exec grep -l \"pub struct \" {} \\\\;)",
      "Bash(cat ~/.cargo/registry/src/index.crates.io-*/ratatui-core-0.1.0/src/style/color.rs)",
      "Bash(cat:*)",
      "Bash(git diff:*)",
      "Read(//tmp/**)",
      "Bash(make tag *)",
      "Bash(make release *)",
      "Bash(gh run *)",
      "Bash(cargo install *)",
      "Bash(make build *)",
      "Bash(make publish *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}